# Copy to .env locally. Never commit, upload or share the completed .env.
# Only npm run deploy and npm run deploy:check read this file; the build and the editor do not.
# sftp (SSH, usually port 22) or ftps (FTP with explicit TLS, usually port 21). Plain FTP is not supported.
DEPLOY_PROTOCOL=sftp
# Hostname or IP address, without protocol or path.
DEPLOY_HOST=example.invalid
DEPLOY_PORT=22
DEPLOY_USER=
# Existing absolute web directory. FTPS only: use / if the FTP account is restricted to the web directory.
DEPLOY_REMOTE_DIR=/public_html
# SFTP only (leave empty for ftps). Obtain and independently verify this fingerprint with the hosting provider.
# Format: SHA256: followed by the actual base64 SHA-256 fingerprint (not a WinSCP string).
DEPLOY_HOST_KEY_SHA256=
# Fill exactly ONE authentication method. Quotes preserve spaces and # characters.
DEPLOY_PASSWORD=
# Optional alternative (SFTP only): absolute key-file path or a path relative to the project directory.
# Keep private keys outside the project directory, in a protected local folder.
DEPLOY_PRIVATE_KEY=
# Only when the private key is encrypted:
DEPLOY_PASSPHRASE=
