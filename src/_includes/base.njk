<!doctype html>
<html lang="{{ site.language }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}{% if not homepage %} | {{ site.name }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta name="color-scheme" content="light dark">
  <script>{% include 'theme.js' %}</script>
  <link rel="icon" href="/assets/graphics/logos/momentful-io.svg" type="image/svg+xml">
  <link rel="preload" href="/assets/fonts/roboto-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{% assetUrl 'site.css' %}">
  <script src="{% assetUrl 'site.js' %}" defer></script>
</head>
<body class="{% if homepage %}home{% else %}inner{% endif %}">
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="header-inner">
      <a class="brand" href="/" aria-label="Momentful I/O — homepage">{% graphic 'momentful-io', 'logo' %}<span><strong>Momentful</strong> I/O</span></a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="navigation" aria-label="Open navigation" hidden>{% graphic 'menu' %}</button>
      <nav id="navigation" aria-label="Main navigation">
        {% for item in navigation %}<a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{% graphic item.icon %}{{ item.label }}</a>{% endfor %}
      </nav>
    </div>
  </header>
  <main id="main" tabindex="-1">
    {% if homepage %}
      <section class="hero"><div class="wide"><h1>{{ heading }}</h1><p>{{ introduction }}</p><a class="learn-more" href="/mission/">Learn more<span class="visually-hidden"> about our mission</span></a></div></section>
      <section class="projects wide" id="projects" aria-labelledby="projects-title"><h2 id="projects-title">Projects</h2>
        <div class="project-list">{% for project in collections.projects %}<a class="project-card" href="{{ project.url }}">{% if project.data.logo %}{% graphic project.data.logo, 'logo' %}{% else %}{% graphic 'projects' %}{% endif %}<div class="card-copy"><h3>{{ project.data.name }}</h3><p>{{ project.data.summary }}</p></div>{% graphic 'arrow' %}</a>{% endfor %}</div>
      </section>
    {% else %}
      <div class="page-hero"><div class="article-heading{% if logo %} with-logo{% endif %}">{% if logo %}{% graphic logo, 'logo' %}{% endif %}<div><h1>{{ heading or title }}</h1>{% if subtitle %}<p>{{ subtitle }}</p>{% endif %}</div></div></div>
      <article class="article-content">{{ content | safe }}{% if project or logo %}<nav class="back-links" aria-label="Related pages"><a href="/">Homepage</a></nav>{% endif %}</article>
    {% endif %}
  </main>
  <footer class="site-footer"><div class="theme-control" hidden><label for="theme">Theme:</label><span class="select-wrap"><select id="theme" name="theme"><option value="system">System</option><option value="light">Light</option><option value="dark">Dark</option></select>{% graphic 'chevron' %}</span></div><a href="/imprint/">Imprint</a> <a href="/branding/">Branding</a></footer>
</body>
</html>
